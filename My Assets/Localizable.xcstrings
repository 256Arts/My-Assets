    "Savings rate includes interest you earn on your liquid assets while your purchase payments are being defered (by 1-2 months) by the credit card." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Sparquote umfasst die Zinsen, die du auf deine liquiden Mittel verdienst, während deine Kartenzahlungen um 1–2 Monate gestundet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tasa de ahorro incluye los intereses que ganas sobre tus activos líquidos mientras tus pagos se difieren (1-2 meses) con la tarjeta de crédito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le taux d'épargne inclut les intérêts perçus sur vos actifs liquides pendant que vos paiements sont différés (de 1 à 2 mois) par la carte de crédit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "貯蓄率には、クレジットカードにより購入代金の支払いが（1〜2か月）繰り延べられている間に流動資産で得られる利子が含まれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "储蓄率包括在信用卡延迟付款（1-2个月）期间您流动资产所赚取的利息。"
          }
        }
      }
    },
